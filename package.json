{
    "name": "saturniumbrowser",
    "version": "1.3.2",
    "description": "Navegador personalizado SaturniumBrowser",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --publish never",
        "release": "npm run build",
        "check:metadata": "node scripts/check-metadata.js",
        "prepare:signed-release": "node scripts/prepare-signed-release.js"
    },
    "keywords": [],
    "author": "Jefferson Passarelli Santos",
    "devDependencies": {
        "electron": "^45.4.1",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    },
    "build": {
        "appId": "com.saturnium.browser",
        "productName": "SaturniumBrowser",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*"
        ],
        "icon": "assets/saturniumbrowser-ico.ico",
        "win": {
            "target": "nsis",
            "icon": "assets/saturniumbrowser-ico.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "SaturniumBrowser",
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "publish": {
            "provider": "github",
            "owner": "PixelCode-Squad",
            "repo": "SaturniumBrowser"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PixelCode-Squad/Saturnium-Browser.git"
    },
    "homepage": "https://github.com/PixelCode-Squad/Saturnium-Browser#readme"
}
